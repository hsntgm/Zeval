dist/
dist.saved.*/
/zeval
/zeval.exe
/zeval.asm
/SHA256SUMS.txt
candidates/*.exe
candidates/.*.exe.new
testbuild/*.exe
tactics/bin/
*.o
*.obj
*.res

# python
__pycache__/
*.pyc

# match.py opening-pool cache (recreated on demand)
tests/openings_*.json

